<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>^[%lld song](inflect: true)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld песни</string>
			<key>many</key>
			<string>%lld песен</string>
			<key>one</key>
			<string>%lld песня</string>
			<key>other</key>
			<string>%lld песни</string>
		</dict>
	</dict>
	<key>^[%lld song](inflect: true) · %lld min</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@songs@ · %2$lld мин</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$lld песни</string>
			<key>many</key>
			<string>%1$lld песен</string>
			<key>one</key>
			<string>%1$lld песня</string>
			<key>other</key>
			<string>%1$lld песни</string>
		</dict>
	</dict>
	<key>albums_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@albums@</string>
		<key>albums</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>%ld альбома</string>
			<key>many</key>
			<string>%ld альбомов</string>
			<key>one</key>
			<string>%ld альбом</string>
			<key>other</key>
			<string>%ld альбома</string>
		</dict>
	</dict>
	<key>delete_files_confirmation_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Вы уверены, что хотите удалить %#@files@? Это действие нельзя отменить.</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>%ld файла</string>
			<key>many</key>
			<string>%ld файлов</string>
			<key>one</key>
			<string>%ld файл</string>
			<key>other</key>
			<string>%ld файла</string>
		</dict>
	</dict>
	<key>found_tracks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>Найдено %ld трека</string>
			<key>many</key>
			<string>Найдено %ld треков</string>
			<key>one</key>
			<string>Найден %ld трек</string>
			<key>other</key>
			<string>Найдено %ld трека</string>
		</dict>
	</dict>
