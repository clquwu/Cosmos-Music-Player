<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Cosmos will stop playing in %lld minutes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Cosmos will stop playing in %#@minutes@.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minute</string>
			<key>other</key>
			<string>%lld minutes</string>
		</dict>
	</dict>
	<key>ai_playlist_created_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>“%1$@” was created with %2$#@songs@.</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$ld song</string>
			<key>other</key>
			<string>%2$ld songs</string>
		</dict>
	</dict>
	<key>albums_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@albums@</string>
		<key>albums</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld album</string>
			<key>other</key>
			<string>%ld albums</string>
		</dict>
	</dict>
	<key>delete_files_confirmation_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Are you sure you want to delete %#@files@? This action cannot be undone.</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld file</string>
			<key>other</key>
			<string>%ld files</string>
		</dict>
	</dict>
	<key>found_tracks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Found %ld track</string>
			<key>other</key>
			<string>Found %ld tracks</string>
		</dict>
	</dict>
	<key>imported_song_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld song imported</string>
			<key>other</key>
			<string>%ld songs imported</string>
		</dict>
	</dict>
	<key>playlist_import_repeats</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@ – a playlist holds each song only once.</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld repeated song appears once</string>
			<key>other</key>
			<string>%ld repeated songs appear once</string>
		</dict>
	</dict>
	<key>playlist_import_summary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Imported %1$ld of %2$#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$ld song</string>
			<key>other</key>
			<string>%2$ld songs</string>
		</dict>
	</dict>
	<key>songs_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld song</string>
			<key>other</key>
			<string>%ld songs</string>
		</dict>
	</dict>
	<key>why_faded_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@weeks@</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Set aside for %ld week</string>
			<key>other</key>
			<string>Set aside for %ld weeks</string>
		</dict>
	</dict>
	<key>why_library_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld song in your library</string>
			<key>other</key>
			<string>%ld songs in your library</string>
		</dict>
	</dict>
	<key>why_listens_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@listens@</string>
		<key>listens</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld listen</string>
			<key>other</key>
			<string>%ld listens</string>
		</dict>
	</dict>
</dict>
</plist>
